{{#if isGM}}
    <h2>{{localize "CCSS.stylesheet.globalStyles"}}</h2>
    <p class="notes">{{localize "CCSS.stylesheet.globalStylesHint"}}</p>
    
    <section class="stylesheet-editor" id="ccss-top">
        <code-mirror id="globalStylesheet" class="userStylesheet" name="stylesheet" language="css" aria-label="{{localize CCSS.stylesheet.globalStyles}}">
            {{~stylesheet~}}
        </code-mirror>
    </section>

{{/if}}
<h2>{{localize "CCSS.stylesheet.userStyles"}}</h2> 
<div id="ccss-sep"></div>
<p class="notes">{{localize "CCSS.stylesheet.userStylesHint"}}</p> 

<section class="stylesheet-editor" id="ccss-bottom">
    <code-mirror id="userStylesheet" class="userStylesheet" name="userStylesheet" language="css" aria-label="{{localize CCSS.stylesheet.userStyles}}">
        {{~stylesheet~}}
    </code-mirror>
</section>
