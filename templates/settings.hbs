<div id="ccss-super-container">
    {{#if isGM}}
        <div id="ccss-world-stylesheet" class="stylesheet-container">    
            <h2>{{localize "CCSS.stylesheet.worldStyles"}}</h2>
            <p class="hint">{{localize "CCSS.stylesheet.worldStylesHint"}}</p>
            <section class="stylesheet-editor" id="ccss-top">
                <code-mirror id="worldStylesheet" class="ccssStylesheet" name="worldStylesheet" aria-label="{{localize CCSS.stylesheet.worldStyles}}">
                    {{~worldStylesheet~}}
                </code-mirror>
            </section>
        </div>
        <div id="ccss-separator"></div>
    {{/if}}
        <div id="ccss-user-stylesheet" class="stylesheet-container">
            <h2>{{localize "CCSS.stylesheet.userStyles"}}</h2>
            <p class="hint">{{localize "CCSS.stylesheet.userStylesHint"}}</p>
            <section class="stylesheet-editor" id="ccss-bottom">
                <code-mirror id="userStylesheet" class="ccssStylesheet" name="userStylesheet" aria-label="{{localize CCSS.stylesheet.userStyles}}">
                    {{~userStylesheet~}}
                </code-mirror>
            </section>
        </div>
</div>